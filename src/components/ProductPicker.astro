---
// The family map: six products on three release lines, each with the same five things
// (docs, install, release notes, roadmap, and its version). Versions and release state
// come from src/data/sync.json, which the sync writes, so this can't disagree with the pages.
import sync from '../data/sync.json';

const hot = sync.repos.hotloop.release;
const flow = sync.repos.flow.release;
const cascade = sync.repos.cascade.release;

const latest = (prefix: string) =>
  sync.pages.filter((p) => p.release && p.slug.startsWith(prefix)).map((p) => p.slug).sort((a, b) => b.localeCompare(a, undefined, { numeric: true }))[0];

const lines = [
  { id: 'core', label: 'HotLoop core', version: hot.version, note: 'One codebase, one version. IoT to Edge to Gateway is the path a site grows along, and Edge Relay is the headless forwarder beside them.', notes: `/${latest('releases/hotloop-')}/`, roadmap: '/roadmap/', ids: ['iot', 'edge', 'gateway', 'edge-relay'] },
  { id: 'flow', label: 'Flow', version: flow.version, note: 'Its own release line, running next to HotLoop.', notes: `/${latest('releases/flow-')}/`, roadmap: '/flow/roadmap/', ids: ['flow'] },
  { id: 'cascade', label: 'Cascade', version: cascade.version, note: cascade.prerelease ? 'Pre-release. Its own release line, running next to HotLoop.' : 'Its own release line, running next to HotLoop.', notes: `/${latest('releases/cascade-')}/`, roadmap: '/cascade/roadmap/', ids: ['cascade'] },
];
const install: Record<string, string> = { iot: '/iot/install/', edge: '/edge/install/', gateway: '/gateway/install/', 'edge-relay': '/edge-relay/install/', flow: '/flow/install/', cascade: '/cascade/running/' };
---

<div class="map">
  {lines.map((l) => (
    <section class="line" aria-labelledby={`line-${l.id}`}>
      <header>
        <h3 id={`line-${l.id}`}>{l.label} line</h3>
        <span class="chip ok">{l.id === 'cascade' && cascade.prerelease ? 'Pre-release ' : 'Version '}{l.version}</span>
        <p>{l.note}</p>
      </header>
      <div class="picker">
        {l.ids.map((id) => {
          const p = sync.products.find((x) => x.id === id)!;
          return (
            <article class="card">
              <h4><a href={`/${p.id}/overview/`}>{p.name}</a></h4>
              <p class="tag">{p.tagline}</p>
              <p class="links">
                <a href={`/${p.id}/overview/`}>Docs</a>
                <a href={install[p.id]}>Install</a>
                <a href={l.notes}>Release notes</a>
                <a href={l.roadmap}>Roadmap</a>
              </p>
            </article>
          );
        })}
      </div>
    </section>
  ))}
</div>

<style>
  .map { display: grid; gap: var(--hl-s6); margin-block: var(--hl-s6); }
  .line header { display: flex; flex-wrap: wrap; align-items: center; gap: var(--hl-s2) var(--hl-s3); margin-bottom: var(--hl-s3); }
  .line header h3 { margin: 0; font-size: var(--hl-fs-lg); font-weight: 800; letter-spacing: var(--hl-ls-heading); }
  .line header p { flex-basis: 100%; margin: 0; color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); }
  .picker { display: grid; gap: var(--hl-s4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); }
  .card {
    background: var(--hl-card); border: 1px solid var(--hl-border); border-radius: var(--hl-r-card);
    padding: var(--hl-s5); box-shadow: var(--hl-sh-1); display: flex; flex-direction: column; gap: var(--hl-s2);
  }
  h4 { margin: 0; font-size: var(--hl-fs-md); font-weight: 800; letter-spacing: var(--hl-ls-heading); }
  h4 a { color: var(--hl-ink); text-decoration: none; }
  h4 a:hover { color: var(--hl-link); text-decoration: underline; }
  p { margin: 0; color: var(--hl-ink-soft); font-size: var(--hl-fs-sm); }
  p.tag { color: var(--hl-ink); font-weight: 600; }
  .links { margin-top: auto; padding-top: var(--hl-s2); display: flex; flex-wrap: wrap; gap: var(--hl-s2) var(--hl-s4); font-weight: 600; }
  .chip {
    display: inline-flex; align-items: center; gap: 0.5em; padding: 0.25em 0.8em; border-radius: var(--hl-r-pill);
    border: 1px solid var(--hl-border); background: var(--hl-card);
    font-size: var(--hl-fs-2xs); font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--hl-ink-soft);
  }
  .chip::before { content: ''; width: 0.5em; height: 0.5em; border-radius: 50%; background: currentColor; }
  .chip.ok { color: var(--hl-ok-text); background: var(--hl-ok-tint); border-color: color-mix(in srgb, var(--hl-ok) 35%, transparent); }
</style>
